<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">
    <xs:element name="jornada">
        <xs:complexType>
            <xs:sequence>

            <xs:element name="partido" maxOccurs="unbounded">
                <xs:complexType>
                    <xs:sequence>

                    <xs:element name="equipo_local" type="xs:string"/>
                    <xs:element name="equipo_visitante" type="xs:string"/>
                    <xs:element name="goles_local" type="xs:integer"/>
                    <xs:element name="goles_visitante" type="xs:integer"/>
                    <xs:element name="estadio" type="xs:string"/>

                    </xs:sequence>
                </xs:complexType>
            </xs:element>

            </xs:sequence>
            <xs:attribute name="fecha" type="xs:date" use="required"/>
        </xs:complexType>
    </xs:element>

</xs:schema>